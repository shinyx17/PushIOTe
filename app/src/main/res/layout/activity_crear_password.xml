<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/imgLogoCrear"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="50dp"
            android:src="@drawable/logo"
            android:contentDescription="Logo"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="NUEVA CONTRASEÑA"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNuevaPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:hint="INGRESE NUEVA CLAVE"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etConfirmarPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="CONFIRME NUEVA CLAVE"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnCambiarPassword"
            android:layout_width="200dp"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:text="ACTUALIZAR"
            android:textStyle="bold"
            android:backgroundTint="#2EF29B"
            android:textColor="#000000" />

    </LinearLayout>
</ScrollView>