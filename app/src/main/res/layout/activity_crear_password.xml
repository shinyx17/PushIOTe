<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp"
        android:background="@android:color/white">

        <ImageView
            android:id="@+id/imgLogoCrearPassword"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/logo"
            android:contentDescription="Logo de la aplicación"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="CREAR NUEVA CONTRASEÑA"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNuevaPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:hint="NUEVA CONTRASEÑA"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etConfirmarPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:hint="REPETIR CONTRASEÑA"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="La contraseña debe tener mínimo 8 caracteres, una mayúscula, una minúscula, un número y un carácter especial."
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCrearPassword"
            android:layout_width="180dp"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="INGRESAR"
            android:textStyle="bold"
            android:backgroundTint="#2EF29B"
            android:textColor="#000000" />

    </LinearLayout>

</ScrollView>