<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/imgLogoRecuperar"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="50dp"
            android:src="@drawable/logo"
            android:contentDescription="Logo de la aplicación"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="RECUPERAR CONTRASEÑA"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Paso 1: Ingresar Email y solicitar código -->
        <EditText
            android:id="@+id/etEmailRecuperar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:hint="INGRESE EMAIL"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnEnviarCodigo"
            android:layout_width="200dp"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:text="ENVIAR CÓDIGO"
            android:textStyle="bold"
            android:backgroundTint="#2EF29B"
            android:textColor="#000000" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="25dp"
            android:background="#E0E0E0" />

        <!-- Paso 2: Ingresar Código enviado a tu correo -->
        <EditText
            android:id="@+id/etCodigo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="INGRESE CÓDIGO RECIBIDO"
            android:inputType="number"
            android:maxLines="1"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnValidarCodigo"
            android:layout_width="200dp"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:text="VALIDAR CÓDIGO"
            android:textStyle="bold"
            android:backgroundTint="#000000"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>