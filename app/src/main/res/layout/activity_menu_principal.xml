<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <ImageView
            android:id="@+id/imgLogoMenu"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/logo"
            android:contentDescription="Logo de la aplicación"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="MENÚ PRINCIPAL"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGestionUsuarios"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="35dp"
            android:text="GESTIÓN DE USUARIOS"
            android:textStyle="bold"
            android:backgroundTint="#2EF29B"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnSensores"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="20dp"
            android:text="DATOS DE SENSORES"
            android:textStyle="bold"
            android:backgroundTint="#2EF29B"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnDesarrollador"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="20dp"
            android:text="DATOS DEL DESARROLLADOR"
            android:textStyle="bold"
            android:backgroundTint="#2EF29B"
            android:textColor="#000000" />

    </LinearLayout>

</ScrollView>